n  )\n  /\n  (\n    (CAST(SUBSTR(champ.XCL_084, 1, 2) AS REAL) * 3600\n     + CAST(SUBSTR(champ.XCL_084, 4, 2) AS REAL) * 60\n     + CAST(SUBSTR(champ.XCL_084, 7) AS REAL))\n    + CAST(SUBSTR(last.XCL_084, 2) AS REAL)\n  )\n  * 100 AS percentage_faster\nFROM results champ\nCROSS JOIN results last\nJOIN races r ON champ.XCL_074 = r.XCL_065\nWHERE r.XCL_069 = 'Australian Grand Prix'\n  AND r.XCL_066 = 2008\n  AND champ.XCL_079 = 1\n  AND last.XCL_074 = r.XCL_065\n  AND last.XCL_079 = (\n    SELECT MAX(res2.XCL_079)\n    FROM results res2\n    WHERE res2.XCL_074 = r.XCL_065\n      AND res2.XCL_084 IS NOT NULL\n  )","upstream_split":"bird:minidev500:mask-t0-c1"}}
